<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="webcode" translate="label" sortOrder="1000">
            <label>Webcode</label>
        </tab>
        <section id="cronscheduler" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Cron Scheduler</label>
            <tab>webcode</tab>
            <resource>Webcode_CronScheduler::cronscheduler_configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="cronscheduler_email_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Receive Email on Error</label>
                    <comment>Allow/disallow to get email in case of cron execution error or missed cron.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cronscheduler_admin_email" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Receive Email On</label>
                    <comment>Enter comma separated email address to get email on multiple addresses.</comment>
                    <validate>required-entry validate-comma-separated-emails</validate>
                    <depends>
                        <field id="cronscheduler_email_enabled">1</field>
                    </depends>
                </field>
                <field id="schedule" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Receive Email At</label>
                    <validate>required-entry</validate>
                    <!--
                        The msgid must start and end exactly where the text does: Config's DOM
                        converter assigns the node verbatim (no trim), so a leading newline or a
                        trailing indent travels into the msgid and no CSV row can ever match it.
                        The line breaks inside the <pre> block are the diagram and stay.
                    -->
                    <comment><![CDATA[Enter comma separated cron expressions to get email more than once.<br/>
<pre>
* * * * *
| | | | |
| | | | +---- Day of the Week   (range: 0-6, 1 standing for Monday)
| | | +------ Month of the Year (range: 1-12)
| | +-------- Day of the Month  (range: 1-31)
| +---------- Hour              (range: 0-23)
+------------ Minute            (range: 0-59)
Example: 0 0 * * * Daily at midnight
</pre>]]></comment>
                    <depends>
                        <field id="cronscheduler_email_enabled">1</field>
                    </depends>
                </field>
                <field id="cronscheduler_dashboard_enabled" translate="label comment" type="select" sortOrder="40" showInDefault="1">
                    <label>Show Cron Jobs on Dashboard</label>
                    <comment>Allow/disallow to show top running jobs on dashboard.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="max_runtime" translate="label comment" type="text" sortOrder="50" showInDefault="1">
                    <label>Kill Jobs Running Longer Than (minutes)</label>
                    <comment>Checked every 15 minutes. 0 means never. A job can override it in its own edit form (Max Runtime). Default 180.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
