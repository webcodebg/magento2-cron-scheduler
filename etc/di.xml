<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Cron\Observer\ProcessCronQueueObserver" type="Webcode\CronScheduler\Observer\ProcessCronQueueObserver" />
    <!--
        Magento\Framework\ShellInterface has no global preference; it is wired per consumer.
        Reuse Magento_Cron's shellBackgroundCron virtualType so the manual "Regenerate"
        run detaches (background + discarded output) exactly like the core cron daemon.
    -->
    <type name="Webcode\CronScheduler\Controller\Adminhtml\Schedule\Regenerate">
        <arguments>
            <argument name="shell" xsi:type="object">shellBackgroundCron</argument>
        </arguments>
    </type>
</config>
