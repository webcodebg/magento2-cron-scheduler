<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="index">
        <job name="webcode_cronscheduler_status" instance="Webcode\CronScheduler\Cron\Status" method="checkstatus">
            <schedule>* * * * *</schedule>
        </job>
    </group>
    <group id="default">
        <job name="webcode_cronscheduler_jobchecker" instance="Webcode\CronScheduler\Cron\LongJobChecker" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="webcode_send_email" instance="Webcode\CronScheduler\Cron\Sendemail" method="execute">
            <config_path>cronscheduler/general/schedule</config_path>
        </job>
    </group>
</config>
