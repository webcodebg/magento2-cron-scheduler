<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <cronscheduler>
            <general>
                <cronscheduler_email_enabled>0</cronscheduler_email_enabled>
                <cronscheduler_dashboard_enabled>0</cronscheduler_dashboard_enabled>
                <schedule>0 10 * * *</schedule>
                <max_runtime>180</max_runtime>
            </general>
        </cronscheduler>
    </default>
</config>
