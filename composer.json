    "replace": {
        "kiwicommerce/module-cron-scheduler": "*",
        "webcode/module-cron-scheduler": "*"
    },
    "require": {
        "php": "^8.3",
        "magento/framework": ">=103.0.4",
        "magento/module-backend": ">=100.0.0",
        "magento/module-cron": ">=100.0.0"
    },
    "keywords": [
