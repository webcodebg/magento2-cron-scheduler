    "version": "2.1.3",
    "license": ["OSL-3.0"],
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Kiwi Commerce Ltd",
            "email": "hello@kiwicommerce.co.uk",
            "homepage": "https://kiwicommerce.co.uk/",
            "role": "Leader"
        },
        {
            "name": "Kostadin Bashev, Webcode",
            "email": "bashev@webcode.bg",
            "homepage": "https://webcode.bg/",
            "role": "Head Magento Developer"
        }
