<?php /** @var $block */ ?>
<?php $items = $block->getItems() ?>
<?php if (!empty($items['errorMessages']->getData())) : ?>
    <h3><strong>Fatal errors in store</strong></h3>
    <table>
        <thead>
        <tr>
            <th>
                <?= $escaper->escapeHtml(__('Job Code')) ?>
            </th>
            <th>
                <?= $escaper->escapeHtml(__('Error Message')) ?>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($items['errorMessages'] as $item) : ?>
            <tr>
                <td><?= $escaper->escapeHtml($item->getJobCode()) ?></td>
                <td><?= $escaper->escapeHtml($item->getErrorMessage()) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
<?php endif ?>

<?php if (!empty($items['missedJobs']->getData())) : ?>
    <h3><strong>Missed jobs in store</strong></h3>
    <table>
        <thead>
        <tr>
            <th>
                <?= $escaper->escapeHtml(__('Job Code')) ?>
            </th>
            <th>
                <?= $escaper->escapeHtml(__('Count')) ?>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($items['missedJobs'] as $item) : ?>
            <tr>
                <td><?= $escaper->escapeHtml($item->getJobCode()) ?></td>
                <td><?= $escaper->escapeHtml($item->getTotalmissed()) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
<?php endif ?>
